# ---------- Server ----------
NODE_ENV=production
PORT=3000
# Public HTTPS URL of THIS server (used for the M-Pesa callback), no trailing slash
PUBLIC_URL=https://your-app.onrender.com
# Origins allowed to call the API (storefront + admin), comma-separated. Leave empty only for local testing.
ALLOWED_ORIGINS=https://your-storefront.com,https://your-admin.com
# Number of proxies in front of the server (Render/Railway/Heroku = 1)
TRUST_PROXY=1
# Set true once to insert 4 demo products into an empty database
SEED_DEMO_PRODUCTS=false

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://MedAI:Griff2009.@medai.qjvleue.mongodb.net/retryWrites=true&w=majority
MONGODB_DB=maricopa

# ---------- Admin login (used by admin.html) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password

# ---------- M-Pesa Daraja ----------
MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                 # Paybill/Store number (sandbox: 174379)
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till
MPESA_PARTY_B=                         # Till number if BuyGoods; defaults to MPESA_SHORTCODE
# Long random string that becomes part of the callback URL: openssl rand -hex 32
MPESA_CALLBACK_SECRET=
# Optional: comma-separated Safaricom callback IPs to allow-list
MPESA_CALLBACK_IPS=
MPESA_RECONCILE=true
