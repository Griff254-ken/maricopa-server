COLLECTION_PREFIX=store_
# ---------- Server ----------
PORT=3000
# Your deployed server URL (no trailing slash). IntaSend webhooks call back to this address.
PUBLIC_URL=https://maricopa-server.onrender.com
# Websites allowed to call the API, comma separated (storefront + admin page)
ALLOWED_ORIGINS=https://maricopa-r0wh.onrender.com

MONGODB_URI=mongodb+srv://MedAI:Griff2009.@medai.qjvleue.mongodb.net/?retryWrites=true&w=majority


ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Maricopa@2026


# ---------- IntaSend ----------
# sandbox or production
INTASEND_ENV=sandbox
# From IntaSend dashboard → Settings → API Keys
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shared secret you invent; must match the URL you give IntaSend:
#   https://maricopa-server.onrender.com/api/intasend/webhook/<INTASEND_WEBHOOK_CHALLENGE>
INTASEND_WEBHOOK_CHALLENGE=2f8a6c1e9b3d47f0a5c8e2b6d9f1a4c7e0b3d6f9a2c5e8b1

# ---------- Optional ----------
# Adds 4 sample products the first time, when the products collection is empty
SEED_SAMPLE_PRODUCTS=false
